{"abstract":[{"text":"Output integers in decimal and other radixes, as roman numerals, or in natural language.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/Directives"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/IntegerDirectives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Integer directives"},"primaryContentSections":[{"content":[{"anchor":"Decimal-~D","level":2,"text":"Decimal (~D)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"D","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output in decimal radix. ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" should be an integer, in which case no decimal point is printed. For floating-point numbers which do not represent an integer, a decimal point and a fractional part are output.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" (default: 0) specifies the minimal “width” of the output of the directive in characters with ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) defining the character that is used to pad the output on the left to make sure it is at least ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" characters long.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Number: ~D\", args: 8273)","⇒ Number: 8273","try clformat(\"Number: ~6D\", args: 8273)","⇒ Number:   8273","try clformat(\"Number: ~6,'0D\", args: 8273)","⇒ Number: 008273"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"By default, the number is output without grouping separators. ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" specifies which character should be used to separate sequences of ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":" digits in the output. Grouping of digits gets enabled with the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"|~10:D|\", args: 1734865)","⇒ | 1,734,865|","try clformat(\"|~10,,'.:D|\", args: 1734865)","⇒ | 1.734.865|"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A sign is output only if the number is negative. With the modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" it is possible to force output also of positive signs. To facilitate the localization of output, function ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":" supports a parameter ","type":"text"},{"code":"locale:","type":"codeVoice"},{"text":". Locale-specific output can be enabled by using the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~+D\", locale: Locale(identifier: \"de_CH\"), args: 14321)","⇒ 14'321"],"syntax":"swift","type":"codeListing"},{"anchor":"Binary-~B","level":2,"text":"Binary (~B)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"B","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Binary directive ","type":"text"},{"code":"~B","type":"codeVoice"},{"text":" is just like decimal directive ","type":"text"},{"code":"~D","type":"codeVoice"},{"text":" but it outputs the next argument in binary radix (radix 2) instead of decimal. It uses the space character as the default for ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" and has a default grouping size of 4 as the default for ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"bin(~D) = ~B\", args: 178, 178)","⇒ bin(178) = 10110010","try clformat(\"~:B\", args: 59701)","⇒ 1110 1001 0011 0101","try clformat(\"~19,'0,'.:B\", args: 31912)","⇒ 0111.1100.1010.1000"],"syntax":"swift","type":"codeListing"},{"anchor":"Octal-~O","level":2,"text":"Octal (~O)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"O","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Octal directive ","type":"text"},{"code":"~O","type":"codeVoice"},{"text":" is just like decimal directive ","type":"text"},{"code":"~D","type":"codeVoice"},{"text":" but it outputs the next argument in octal radix (radix 8) instead of decimal. It uses the space character as the default for ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" and has a default grouping size of 4 as the default for ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"bin(~D) = ~O\", args: 178, 178)","⇒ bin(178) = 262","try clformat(\"~:O\", args: 59701)","⇒ 16 4465","try clformat(\"~9,'0,',:O\", args: 31912)","⇒ 0007,6250"],"syntax":"swift","type":"codeListing"},{"anchor":"Hexadecimal-~X","level":2,"text":"Hexadecimal (~X)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"X","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Hexadecimal directive ","type":"text"},{"code":"~X","type":"codeVoice"},{"text":" is just like decimal directive ","type":"text"},{"code":"~D","type":"codeVoice"},{"text":" but it outputs the next argument in hexadecimal radix (radix 16) instead of decimal. It uses the colon character as the default for ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" and has a default grouping size of 2 as the default for ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":". With modifier ","type":"text"},{"code":"+","type":"codeVoice"},{"text":", upper case characters are used for representing hexadecimal digits.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"bin(~D) = ~X\", args: 9968, 9968)","⇒ bin(9968) = 26f0","try clformat(\"~:X\", args: 999701)","⇒ f:41:15","try clformat(\"~+X\", args: 999854)","⇒ F41AE"],"syntax":"swift","type":"codeListing"},{"anchor":"Radix-~R","level":2,"text":"Radix (~R)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"radix,mincol,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"R","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is expected to be an integer. It will be output with radix ","type":"text"},{"inlineContent":[{"text":"radix","type":"text"}],"type":"emphasis"},{"text":". ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" (default: 0) specifies the minimal “width” of the output of the directive in characters with ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) defining the character that is used to pad the output on the left to make it at least ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" characters long.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Number: ~10R\", args: 1272)","⇒ Number: 1272","try clformat(\"Number: ~16,8,'0R\", args: 7121972)","⇒ Number: 006cac34","try clformat(\"Number: ~2R\", args: 173)","⇒ Number: 10101101"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"By default, the number is output without grouping separators. ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" specifies which character should be used to separate sequences of ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":" digits in the output. Grouping of digits is enabled with the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~16,8,,':,2:R\", args: 7121972)","⇒ 6c:ac:34","try clformat(\"~2,14,'0,'.,4:R\", args: 773)","⇒ 0011.0000.0101"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A sign is output only if the number is negative. With the modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" it is possible to force output also of positive signs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If parameter ","type":"text"},{"inlineContent":[{"text":"radix","type":"text"}],"type":"emphasis"},{"text":" is not specified at all, then an entirely different interpretation is given. ","type":"text"},{"code":"~R","type":"codeVoice"},{"text":" outputs ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" as a cardinal number in natural language. The form ","type":"text"},{"code":"~:R","type":"codeVoice"},{"text":" outputs ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" as an ordinal number in natural language. ","type":"text"},{"code":"~@R","type":"codeVoice"},{"text":" outputs ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" as a Roman numeral.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~R\", args: 572)","⇒ five hundred seventy-two","try clformat(\"~:R\", args: 3)","⇒ 3rd","try clformat(\"~@R\", args: 1272)","⇒ MCCLXXII"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Whenever output is provided in natural language, English is used as the language by default. By specifying the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier, it is possible to switch the language to the language of the locale provided to function ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":". In fact, modifier ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" plays two different roles: If the given radix is greater than 10, upper case characters are used for representing alphabetic digits. If the radix is omitted, usage of modifier ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" enables locale-specific output determined by the ","type":"text"},{"code":"locale:","type":"codeVoice"},{"text":" parameter of function ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~+R\", locale: Locale(identifier: \"de_DE\"), args: 572)","⇒ fünf­hundert­zwei­und­siebzig","try clformat(\"~10+R\", locale: Locale(identifier: \"de_CH\"), args: 14321)","⇒ 14'321","try clformat(\"~16R vs ~16+R\", args: 900939, 900939)","⇒ dbf4b vs DBF4B"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/ControlDirectives":{"abstract":[{"text":"Navigate arguments, process control strings recursively, convert case, and select or repeat parts of a control string.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","kind":"article","role":"article","title":"Control directives","type":"topic","url":"/documentation/clformat/controldirectives"},"doc://CLFormat/documentation/CLFormat/Directives":{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/Directives","kind":"article","role":"collectionGroup","title":"Directive reference","type":"topic","url":"/documentation/clformat/directives"},"doc://CLFormat/documentation/CLFormat/FloatDirectives":{"abstract":[{"text":"Output floating-point numbers in fixed, exponential, and monetary formats.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","kind":"article","role":"article","title":"Floating-point directives","type":"topic","url":"/documentation/clformat/floatdirectives"},"doc://CLFormat/documentation/CLFormat/LayoutDirectives":{"abstract":[{"text":"Control newlines, tabulation, and the justification of text.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","kind":"article","role":"article","title":"Layout directives","type":"topic","url":"/documentation/clformat/layoutdirectives"},"doc://CLFormat/documentation/CLFormat/TextDirectives":{"abstract":[{"text":"Output arguments as text, characters, or plurals.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","kind":"article","role":"article","title":"Text and character directives","type":"topic","url":"/documentation/clformat/textdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Directives-by-category","generated":true,"identifiers":["doc://CLFormat/documentation/CLFormat/TextDirectives","doc://CLFormat/documentation/CLFormat/FloatDirectives","doc://CLFormat/documentation/CLFormat/LayoutDirectives","doc://CLFormat/documentation/CLFormat/ControlDirectives"],"title":"Directives by category"}],"variants":[{"paths":["/documentation/clformat/integerdirectives"],"traits":[{"interfaceLanguage":"swift"}]}]}