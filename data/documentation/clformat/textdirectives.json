{"abstract":[{"text":"Output arguments as text, characters, or plurals.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/Directives"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/TextDirectives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Text and character directives"},"primaryContentSections":[{"content":[{"anchor":"ASCII-~A","level":2,"text":"ASCII (~A)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,colinc,minpad,padchar,maxcol,elchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"A","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output without escape characters. In particular, if ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is a string, its characters will be output verbatim. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is nil, it will be output as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not nil, then the formatter will attempt to convert ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" using one of the following properties (tried in the order as listed below) into a string that is output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CLFormatConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"clformatDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String interpolation is used to turn ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" into a string.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" (default: 0) specifies the minimal “width” of the output of the directive in characters, ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":" (default: ∞) specifies the maximum width. ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) defines the character that is used to pad the output to make sure it is at least ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" characters long. By default, the output is padded on the right with at least ","type":"text"},{"inlineContent":[{"text":"minpad","type":"text"}],"type":"emphasis"},{"text":" (default: 0) copies of ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":". Padding characters are then inserted ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" (default: 1) characters at a time until the total width is at least ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":". Padding is capped such that the output never exceeds ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":" characters. If, without padding, the output is already longer than ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":", the output is truncated at width ","type":"text"},{"inlineContent":[{"text":"maxcol - 1","type":"text"}],"type":"emphasis"},{"text":" and the ellipsis character ","type":"text"},{"inlineContent":[{"text":"elchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘…’) is inserted at the end.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Modifier ","type":"text"},{"code":":","type":"codeVoice"},{"text":" enables debugging output, i.e. the following sequence of properties of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" are considered for generating the output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"DebugCLFormatConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"clformatDebugDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The properties as listed above are tried to generate the output.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" enables padding on the left to right-align the output.","type":"text"}],"type":"paragraph"},{"anchor":"Write-~W","level":2,"text":"Write (~W)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,colinc,minpad,padchar,maxcol,elchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"W","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output without escape characters just as if it was printed via Swift’s ","type":"text"},{"code":"print","type":"codeVoice"},{"text":" function. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is nil, it will be output as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not nil, then the formatter will attempt to convert ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" using one of the following properties (tried in the order as listed below) into a string that is output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier was provided and ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String interpolation is used to turn ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" into a string.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Parameters ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" (default: 0), ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" (default: 1), ","type":"text"},{"inlineContent":[{"text":"minpad","type":"text"}],"type":"emphasis"},{"text":" (default: 0), ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’), ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":" (default: ∞), and ","type":"text"},{"inlineContent":[{"text":"elchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘…’) are used just as described for the ","type":"text"},{"inlineContent":[{"text":"ASCII directive","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"~A","type":"codeVoice"},{"text":". Modifier ","type":"text"},{"code":":","type":"codeVoice"},{"text":" enables debugging output. Modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" enables padding on the left to right-align the output.","type":"text"}],"type":"paragraph"},{"anchor":"Source-~S","level":2,"text":"Source (~S)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,colinc,minpad,padchar,maxcol,elchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"S","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output with escape characters. In particular, if ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is a string, double-quotes delimit the characters of the string. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is a character, single-quotes delimit the character. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is nil, it will be output as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For all other values, the formatter will attempt to convert ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" using one of the following properties (tried in the order as listed below) into a string that is output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier was provided and ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"DebugCLFormatConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"clformatDebugDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier was provided and ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CLFormatConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"clformatDescription","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" implements protocol ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":" then property ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" will be output.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String interpolation is used to turn ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" into a string.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Parameters ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" (default: 0), ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" (default: 1), ","type":"text"},{"inlineContent":[{"text":"minpad","type":"text"}],"type":"emphasis"},{"text":" (default: 0), ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’), ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":" (default: ∞), and ","type":"text"},{"inlineContent":[{"text":"elchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘…’) are used just as described for the ","type":"text"},{"inlineContent":[{"text":"ASCII directive","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"~A","type":"codeVoice"},{"text":". Modifier ","type":"text"},{"code":":","type":"codeVoice"},{"text":" enables debugging output. Modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" enables padding on the left to right-align the output.","type":"text"}],"type":"paragraph"},{"anchor":"Character-~C","level":2,"text":"Character (~C)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~C","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" should be a character. Directive ","type":"text"},{"code":"~C","type":"codeVoice"},{"text":" outputs ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" in a form dependent on the modifiers used. Without any modifiers, ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as if the character was used in a string.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier is provided, a representation based on ","type":"text"},{"inlineContent":[{"text":"Unicode scalars","type":"text"}],"type":"emphasis"},{"text":" is chosen. Without further modifiers, ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output using Swift’s Unicode scalar escape syntax ","type":"text"},{"code":"\\u{...}","type":"codeVoice"},{"text":" so that the result can be used within a Swift string literal. By adding the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier, the result is automatically surrounded by double-quotes. The modifier combination ","type":"text"},{"code":"@:","type":"codeVoice"},{"text":" will lead to ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" being output as Unicode code points. The combination ","type":"text"},{"code":"@:+","type":"codeVoice"},{"text":" will output ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" as a sequence of Unicode scalar property names, separated by comma.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier is used (without ","type":"text"},{"code":"@","type":"codeVoice"},{"text":"), a representation of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" for the usage in XML documents is chosen. By default, a Unicode-based XML character encoding is used, unless ","type":"text"},{"code":":","type":"codeVoice"},{"text":" is combined with ","type":"text"},{"code":"+","type":"codeVoice"},{"text":", in which case the character is represented as a XML named character entity when possible, otherwise, the character is output in raw form.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~C\", args: \"A\")","⇒ A","try clformat(\"~@C\", args: \"A\")","⇒ \\u{41}","try clformat(\"~@+C\", args: \"A\")","⇒ \"\\u{41}\"","try clformat(\"~@:C\", args: \"©\")","⇒ U+00A9","try clformat(\"~@:+C\", args: \"©\")","⇒ COPYRIGHT SIGN","try clformat(\"~:C\", args: \"©\")","⇒ &#xA9;","try clformat(\"~:+C\", args: \"©\")","⇒ &copy;"],"syntax":"swift","type":"codeListing"},{"anchor":"Plural-~P","level":2,"text":"Plural (~P)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~P","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Depending on the next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":", which is expected to be an integer value, a different string is output. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not equal to 1, a lowercase ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" is output. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is equal to 1, nothing is output.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier is provided, the last argument is used instead for ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":". This is useful after outputting a number using ","type":"text"},{"code":"~D","type":"codeVoice"},{"text":". With the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier, ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" is output if ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is 1, or ","type":"text"},{"code":"ies","type":"codeVoice"},{"text":" if it is not.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~D tr~:@P/~D win~:P\", args: 7, 1)","⇒ 7 tries/1 win","try clformat(\"~D tr~:@P/~D win~:P\", args: 1, 0)","⇒ 1 try/0 wins"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/ControlDirectives":{"abstract":[{"text":"Navigate arguments, process control strings recursively, convert case, and select or repeat parts of a control string.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","kind":"article","role":"article","title":"Control directives","type":"topic","url":"/documentation/clformat/controldirectives"},"doc://CLFormat/documentation/CLFormat/Directives":{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/Directives","kind":"article","role":"collectionGroup","title":"Directive reference","type":"topic","url":"/documentation/clformat/directives"},"doc://CLFormat/documentation/CLFormat/FloatDirectives":{"abstract":[{"text":"Output floating-point numbers in fixed, exponential, and monetary formats.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","kind":"article","role":"article","title":"Floating-point directives","type":"topic","url":"/documentation/clformat/floatdirectives"},"doc://CLFormat/documentation/CLFormat/IntegerDirectives":{"abstract":[{"text":"Output integers in decimal and other radixes, as roman numerals, or in natural language.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","kind":"article","role":"article","title":"Integer directives","type":"topic","url":"/documentation/clformat/integerdirectives"},"doc://CLFormat/documentation/CLFormat/LayoutDirectives":{"abstract":[{"text":"Control newlines, tabulation, and the justification of text.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","kind":"article","role":"article","title":"Layout directives","type":"topic","url":"/documentation/clformat/layoutdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Directives-by-category","generated":true,"identifiers":["doc://CLFormat/documentation/CLFormat/IntegerDirectives","doc://CLFormat/documentation/CLFormat/FloatDirectives","doc://CLFormat/documentation/CLFormat/LayoutDirectives","doc://CLFormat/documentation/CLFormat/ControlDirectives"],"title":"Directives by category"}],"variants":[{"paths":["/documentation/clformat/textdirectives"],"traits":[{"interfaceLanguage":"swift"}]}]}