{"abstract":[{"text":"A format configuration value contains an argument factory, a default representation","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", as well as a mapping from directive identifiers (characters) to directive","type":"text"},{"text":" ","type":"text"},{"text":"parsers which parse the directive. Most directives are atomic (i.e. they are not","type":"text"},{"text":" ","type":"text"},{"text":"composite) and parsing for those is trivial: they just package up the generically","type":"text"},{"text":" ","type":"text"},{"text":"parsed parameters and modifiers in a new directive specifier value. Composite","type":"text"},{"text":" ","type":"text"},{"text":"directives have more complex parsing logic.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/CLFormatConfig"},"kind":"symbol","metadata":{"externalID":"s:8CLFormat0A6ConfigV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLFormatConfig"}],"modules":[{"name":"CLFormat"}],"navigatorTitle":[{"kind":"identifier","text":"CLFormatConfig"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"CLFormatConfig"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLFormatConfig"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://CLFormat/documentation/CLFormat/CustomDirectives"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Format configurations are value types and can be shared between threads. Since they","type":"text"},{"text":" ","type":"text"},{"text":"hold closures (argument factory, directive parsers) and an environment with values of","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary types, the compiler cannot verify this. Hence, ","type":"text"},{"code":"CLFormatConfig","type":"codeVoice"},{"text":" is declared","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":": argument factories and directive parsers must be thread-safe,","type":"text"},{"text":" ","type":"text"},{"text":"and the values stored in ","type":"text"},{"code":"environment","type":"codeVoice"},{"text":" must not be mutated while they are in use.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/CLControlParser":{"abstract":[{"text":"Implementation of a control string parser. The parser implements a generic","type":"text"},{"text":" ","type":"text"},{"text":"directive parser which then triggers directive-specific parsers that handle","type":"text"},{"text":" ","type":"text"},{"text":"composite directives (such as conversion, iteration, justification, and","type":"text"},{"text":" ","type":"text"},{"text":"conditional directives).","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLControlParser"}],"identifier":"doc://CLFormat/documentation/CLFormat/CLControlParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CLControlParser"}],"role":"symbol","title":"CLControlParser","type":"topic","url":"/documentation/clformat/clcontrolparser"},"doc://CLFormat/documentation/CLFormat/CLFormatConfig":{"abstract":[{"text":"A format configuration value co