{"abstract":[{"text":"Control newlines, tabulation, and the justification of text.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/Directives"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/LayoutDirectives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Layout directives"},"primaryContentSections":[{"content":[{"anchor":"Newline-~","level":2,"text":"Newline (~%)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"%","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive outputs ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" (default: 1) newline characters, thereby terminating the current output line and beginning a new one. No arguments are being consumed. Simply putting ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" newline escape characters ","type":"text"},{"code":"\\n","type":"codeVoice"},{"text":" into the control string would also work, but ","type":"text"},{"code":"~%","type":"codeVoice"},{"text":" is often used because it makes the control string look nicer and more consistent.","type":"text"}],"type":"paragraph"},{"anchor":"Freshline-~","level":2,"text":"Freshline (~&)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"&","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Unless it can be determined that the output is already at the beginning of a line, this directive outputs a newline if ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" > 0. This conditional newline is followed by ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" − 1 newlines, if ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" > 1. Nothing is output if ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" = 0.","type":"text"}],"type":"paragraph"},{"anchor":"Page-separator-~%7C","level":2,"text":"Page separator (~|)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"|","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive outputs ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" (default: 1) page separator characters (","type":"text"},{"code":"\"\\u{12}\"","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"Tilde-~~","level":2,"text":"Tilde (~~)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive outputs ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" (default: 1) tilde characters.","type":"text"}],"type":"paragraph"},{"anchor":"Tabulate-~T","level":2,"text":"Tabulate (~T)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"colnum,colinc","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"T","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive will output sufficient spaces to move the cursor to column ","type":"text"},{"inlineContent":[{"text":"colnum","type":"text"}],"type":"emphasis"},{"text":" (default: 1). If the cursor is already at or beyond column ","type":"text"},{"inlineContent":[{"text":"colnum","type":"text"}],"type":"emphasis"},{"text":", the directive will output spaces to move the cursor to column ","type":"text"},{"inlineContent":[{"text":"colnum + k × colinc","type":"text"}],"type":"emphasis"},{"text":" for the smallest positive integer ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" possible, unless ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" (default: 1) is zero, in which case no spaces are output if the cursor is already at or beyond column ","type":"text"},{"inlineContent":[{"text":"colnum","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" is provided, relative tabulation is performed. In this case, the directive outputs ","type":"text"},{"inlineContent":[{"text":"colrel","type":"text"}],"type":"emphasis"},{"text":" spaces and then outputs the smallest non-negative number of additional spaces necessary to move the cursor to a column that is a multiple of ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":". For example, the directive ","type":"text"},{"code":"~3,8@T","type":"codeVoice"},{"text":" outputs three spaces and then moves the cursor to a “standard multiple-of-eight tab stop” if not at one already. If the current output column cannot be determined, however, then ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" is ignored, and exactly ","type":"text"},{"inlineContent":[{"text":"colrel","type":"text"}],"type":"emphasis"},{"text":" spaces are output.","type":"text"}],"type":"paragraph"},{"anchor":"Line-continuation-~-and-a-newline","level":2,"text":"Line continuation (~ and a newline)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"newline","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"~:","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"newline","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"~@","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"newline","type":"text"}],"type":"emphasis"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive consumes the newline character that follows the tilde. It makes it possible to break long control strings over several lines. Without modifiers, the newline and the space characters at the beginning of the next line are ignored, so the continuation line can be indented freely. With the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier, only the newline is ignored and the spaces of the next line are kept. With the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier, the newline is kept (as if ","type":"text"},{"code":"~%","type":"codeVoice"},{"text":" had been used), and the spaces of the next line are ignored. The combination ","type":"text"},{"code":":@","type":"codeVoice"},{"text":" is not supported.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"one~\\n   two~\\n   three\")","⇒ onetwothree","try clformat(\"one~:\\n   two\")","⇒ one   two","try clformat(\"one~@\\n   two\")","⇒ one","  two"],"syntax":"swift","type":"codeListing"},{"anchor":"Justification-~%3C~%3E","level":2,"text":"Justification (~<…~>)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"mincol,colinc,minpad,padchar,maxcol,elchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"<","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~>","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This directive justifies the text produced by processing control string ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" within a field which is at least ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":" columns wide (default: 0). ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" may be divided up into segments via directive ","type":"text"},{"code":"~;","type":"codeVoice"},{"text":", in which case the spacing is evenly divided between the text segments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With no modifiers, the leftmost text segment is left-justified in the field and the rightmost text segment is right-justified. If there is only one text element, it is right-justified. The ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier causes spacing to be introduced before the first text segment. The ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier causes spacing to be added after the last text segment. The ","type":"text"},{"inlineContent":[{"text":"minpad","type":"text"}],"type":"emphasis"},{"text":" parameter (default: 0) is the minimum number of padding characters to be output between each segment. Whenever padding is needed, the padding character ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) is used. If the total width needed to satisfy the constraints is greater than ","type":"text"},{"inlineContent":[{"text":"mincol","type":"text"}],"type":"emphasis"},{"text":", then the width used is ","type":"text"},{"inlineContent":[{"text":"mincol + k × colinc","type":"text"}],"type":"emphasis"},{"text":" for the smallest possible non-negative integer ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"colinc","type":"text"}],"type":"emphasis"},{"text":" defaulting to 1.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"|~10,,,'.<foo~;bar~>|\")","⇒ |foo....bar|","try clformat(\"|~10,,,'.:<foo~;bar~>|\")","⇒ |..foo..bar|","try clformat(\"|~10,,,'.:@<foo~;bar~>|\")","⇒ |..foo.bar.|","try clformat(\"|~10,,,'.<foobar~>|\")","⇒ |....foobar|","try clformat(\"|~10,,,'.:<foobar~>|\")","⇒ |....foobar|","try clformat(\"|~10,,,'.@<foobar~>|\")","⇒ |foobar....|","try clformat(\"|~10,,,'.:@<foobar~>|\")","⇒ |..foobar..|"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Note that ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" may include format directives. All the clauses in ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" are processed in order. It is the resulting pieces of text that are justified. The ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" directive may be used to terminate processing of the clauses prematurely, in which case only the completely processed clauses are justified.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the first clause of a ","type":"text"},{"code":"~<","type":"codeVoice"},{"text":" directive is terminated with ","type":"text"},{"code":"~:;","type":"codeVoice"},{"text":" instead of ","type":"text"},{"code":"~;","type":"codeVoice"},{"text":", then it is used in a special way. All of the clauses are processed, but the first one is not used in performing the spacing and padding. When the padded result has been determined, then, if it fits on the current line of output, it is output, and the text for the first clause is discarded. If, however, the padded text does not fit on the current line, then the text segment for the first clause is output before the padded text. The first clause ought to contain a newline (such as a ","type":"text"},{"code":"~%","type":"codeVoice"},{"text":" directive). The first clause is always processed, and so any arguments it refers to will be used. The decision is whether to use the resulting segment of text, not whether to process the first clause. If the ","type":"text"},{"code":"~:;","type":"codeVoice"},{"text":" has a prefix parameter ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":", then the padded text must fit on the current line with ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" character positions to spare to avoid outputting the first clause’s text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the control string in the following example can be used to print a list of items separated by comma without breaking items over line boundaries, beginning each line with ","type":"text"},{"code":";;","type":"codeVoice"},{"text":". The prefix parameter 1 in ","type":"text"},{"code":"~1:;","type":"codeVoice"},{"text":" accounts for the width of the comma that will follow the justified item if it is not the last element in the list, or the period if it is. If ","type":"text"},{"code":"~:;","type":"codeVoice"},{"text":" has a second prefix parameter, like below, then it is used as the width of the line, overriding the line width as specified by ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"linewidth:","type":"codeVoice"},{"text":" parameter (default: 80).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The output begins and ends with a newline character:","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~%;; ~{~<~%;; ~1,30:; ~S~>~^,~}.~%\",","             args: [\"first line\", \"second\", \"a long third line\",","                    \"fourth\", \"fifth\"])","⇒ ;;  \"first line\", \"second\",","  ;;  \"a long third line\",","  ;;  \"fourth\", \"fifth\"."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If there is only one text segment ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" and parameter ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":" is provided and the length of the output of ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" is exceeding ","type":"text"},{"inlineContent":[{"text":"maxcol","type":"text"}],"type":"emphasis"},{"text":", then the output is truncated at width ","type":"text"},{"inlineContent":[{"text":"maxcol - 1","type":"text"}],"type":"emphasis"},{"text":" and the ellipsis character ","type":"text"},{"inlineContent":[{"text":"elchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘…’) is inserted at the end.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/ControlDirectives":{"abstract":[{"text":"Navigate arguments, process control strings recursively, convert case, and select or repeat parts of a control string.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","kind":"article","role":"article","title":"Control directives","type":"topic","url":"/documentation/clformat/controldirectives"},"doc://CLFormat/documentation/CLFormat/Directives":{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/Directives","kind":"article","role":"collectionGroup","title":"Directive reference","type":"topic","url":"/documentation/clformat/directives"},"doc://CLFormat/documentation/CLFormat/FloatDirectives":{"abstract":[{"text":"Output floating-point numbers in fixed, exponential, and monetary formats.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","kind":"article","role":"article","title":"Floating-point directives","type":"topic","url":"/documentation/clformat/floatdirectives"},"doc://CLFormat/documentation/CLFormat/IntegerDirectives":{"abstract":[{"text":"Output integers in decimal and other radixes, as roman numerals, or in natural language.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","kind":"article","role":"article","title":"Integer directives","type":"topic","url":"/documentation/clformat/integerdirectives"},"doc://CLFormat/documentation/CLFormat/TextDirectives":{"abstract":[{"text":"Output arguments as text, characters, or plurals.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","kind":"article","role":"article","title":"Text and character directives","type":"topic","url":"/documentation/clformat/textdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Directives-by-category","generated":true,"identifiers":["doc://CLFormat/documentation/CLFormat/TextDirectives","doc://CLFormat/documentation/CLFormat/IntegerDirectives","doc://CLFormat/documentation/CLFormat/FloatDirectives","doc://CLFormat/documentation/CLFormat/ControlDirectives"],"title":"Directives by category"}],"variants":[{"paths":["/documentation/clformat/layoutdirectives"],"traits":[{"interfaceLanguage":"swift"}]}]}