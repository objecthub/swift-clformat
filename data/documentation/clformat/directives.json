{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/Directives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"collectionGroup","title":"Directive reference"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The formatting directives supported by the ","type":"text"},{"inlineContent":[{"text":"CLFormat","type":"text"}],"type":"emphasis"},{"text":" framework are based on the directives specified in ","type":"text"},{"identifier":"https://www.cs.cmu.edu/Groups/AI/html/cltl/clm/node1.html","isActive":true,"type":"reference"},{"text":" by Guy L. Steele Jr. Some directives have been extended to meet today’s formatting requirements (e.g. to support localization) and to achieve a natural embedding in Swift. All extensions were introduced in a way to not impact backward compatibility.","type":"text"}],"type":"paragraph"},{"anchor":"Syntax-of-directives","level":3,"text":"Syntax of directives","type":"heading"},{"inlineContent":[{"text":"Every directive starts with a tilde (","type":"text"},{"code":"~","type":"codeVoice"},{"text":"), is followed by optional comma-separated ","type":"text"},{"inlineContent":[{"text":"parameters","type":"text"}],"type":"emphasis"},{"text":" and optional ","type":"text"},{"inlineContent":[{"text":"modifiers","type":"text"}],"type":"emphasis"},{"text":", and ends with a character that identifies the directive:","type":"text"}],"type":"paragraph"},{"code":["~param1,param2,...mX","","where m = (potentially empty) sequence of modifier characters \":\", \"@\", and \"+\"","      X = character identifying the directive type"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Directive characters that are letters can be written in lower or upper case: ","type":"text"},{"code":"~a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"~A","type":"codeVoice"},{"text":" are the same directive. A parameter is one of the following:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"An integer, such as ","type":"text"},{"code":"~10D","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"~,2,-2F","type":"codeVoice"},{"text":". Integer parameters must be in the range from -1,000,000 to 1,000,000 (see ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/Parameters/maxNumber","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A character, written with a leading quote, such as ","type":"text"},{"code":"~10,'0D","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The letter ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", which takes the value of the parameter from the next argument, such as ","type":"text"},{"code":"~vD","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The character ","type":"text"},{"code":"#","type":"codeVoice"},{"text":", which stands for the number of arguments that are left, such as ","type":"text"},{"code":"~#D","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Nothing: omitted parameters have default values, such as in ","type":"text"},{"code":"~,2F","type":"codeVoice"},{"text":". Trailing parameters can be left out entirely.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The modifiers ","type":"text"},{"code":":","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" change the behavior of a directive in ways that are described with each directive. They can be combined, in any order. Locale-specific output is typically requested with the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier, in combination with the ","type":"text"},{"code":"locale:","type":"codeVoice"},{"text":" parameter of ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/clformat(_:config:locale:tabsize:linewidth:displayWidth:args:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Overview-of-directives","level":3,"text":"Overview of directives","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Directive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Name","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","isActive":true,"overridingTitle":"ASCII","overridingTitleInlineContent":[{"text":"ASCII","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an argument as text, without escape characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~W","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","isActive":true,"overridingTitle":"Write","overridingTitleInlineContent":[{"text":"Write","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an argument like Swift’s ","type":"text"},{"code":"print","type":"codeVoice"},{"text":" function.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~S","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","isActive":true,"overridingTitle":"Source","overridingTitleInlineContent":[{"text":"Source","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an argument with escape characters, delimiting strings and characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~C","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","isActive":true,"overridingTitle":"Character","overridingTitleInlineContent":[{"text":"Character","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a character as text, as Unicode scalars, or as XML.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~P","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","isActive":true,"overridingTitle":"Plural","overridingTitleInlineContent":[{"text":"Plural","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a plural suffix depending on a number.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~D","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","isActive":true,"overridingTitle":"Decimal","overridingTitleInlineContent":[{"text":"Decimal","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an integer in decimal notation, with optional grouping.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~B","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","isActive":true,"overridingTitle":"Binary","overridingTitleInlineContent":[{"text":"Binary","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an integer in binary notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~O","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","isActive":true,"overridingTitle":"Octal","overridingTitleInlineContent":[{"text":"Octal","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an integer in octal notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~X","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","isActive":true,"overridingTitle":"Hexadecimal","overridingTitleInlineContent":[{"text":"Hexadecimal","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an integer in hexadecimal notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~R","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","isActive":true,"overridingTitle":"Radix","overridingTitleInlineContent":[{"text":"Radix","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs an integer in any radix, in natural language, or as an ordinal or roman numeral.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~F","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","isActive":true,"overridingTitle":"Fixed float","overridingTitleInlineContent":[{"text":"Fixed float","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a floating-point number in fixed-point notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~E","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","isActive":true,"overridingTitle":"Exponential float","overridingTitleInlineContent":[{"text":"Exponential float","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a floating-point number in exponential notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~G","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","isActive":true,"overridingTitle":"General float","overridingTitleInlineContent":[{"text":"General float","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a floating-point number in fixed-point or exponential notation.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~$","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","isActive":true,"overridingTitle":"Dollars float","overridingTitleInlineContent":[{"text":"Dollars float","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a monetary amount, optionally with a currency symbol.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~%","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Newline","overridingTitleInlineContent":[{"text":"Newline","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs newlines.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~&","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Freshline","overridingTitleInlineContent":[{"text":"Freshline","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs a newline unless the output is at the beginning of a line.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~|","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Page separator","overridingTitleInlineContent":[{"text":"Page separator","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs page separator characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~~","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Tilde","overridingTitleInlineContent":[{"text":"Tilde","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Outputs tilde characters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~T","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Tabulate","overridingTitleInlineContent":[{"text":"Tabulate","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Moves to a column by outputting spaces.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~","type":"codeVoice"},{"inlineContent":[{"text":"newline","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Line continuation","overridingTitleInlineContent":[{"text":"Line continuation","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Ignores a newline in the control string.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~<…~>","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","isActive":true,"overridingTitle":"Justification","overridingTitleInlineContent":[{"text":"Justification","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Justifies text within a field of a given width.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~*","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","isActive":true,"overridingTitle":"Ignore argument","overridingTitleInlineContent":[{"text":"Ignore argument","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Skips arguments or jumps to another argument.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~?","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","isActive":true,"overridingTitle":"Indirection","overridingTitleInlineContent":[{"text":"Indirection","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Processes an argument as a control string.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~(…~)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","isActive":true,"overridingTitle":"Conversion","overridingTitleInlineContent":[{"text":"Conversion","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Converts case, or escapes the enclosed output.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"~[…~]","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","isActive":true,"overridingTitle":"Conditional","overridingTitleInlineContent":[{"text":"Conditional","type":"text"}],"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Selects one of several control strings.","type":"text"}],"type":"paragraph"}]