{"abstract":[{"text":"Navigate arguments, process control strings recursively, convert case, and select or repeat parts of a control string.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/Directives"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/ControlDirectives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Control directives"},"primaryContentSections":[{"content":[{"anchor":"Ignore-argument-~","level":2,"text":"Ignore argument (~*)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"*","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" (default: 1) arguments are ignored. If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier is provided, arguments are “ignored backwards”, i.e. ","type":"text"},{"code":"~:*","type":"codeVoice"},{"text":" backs up in the list of arguments so that the argument last processed will be processed again. ","type":"text"},{"code":"~n:*","type":"codeVoice"},{"text":" backs up ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" arguments. When within a ","type":"text"},{"code":"~{","type":"codeVoice"},{"text":" construct, the ignoring (in either direction) is relative to the list of arguments being processed by the iteration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The form ","type":"text"},{"code":"~n@*","type":"codeVoice"},{"text":" is an “absolute goto” rather than a “relative goto”: the directive goes to the ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"-th argument, where 0 means the first one. ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" defaults to 0 for this form, so ","type":"text"},{"code":"~@*","type":"codeVoice"},{"text":" goes back to the first argument. Directives after a ","type":"text"},{"code":"~n@*","type":"codeVoice"},{"text":" will take arguments in sequence beginning with the one gone to. When within a ","type":"text"},{"code":"~{","type":"codeVoice"},{"text":" construct, the “goto” is relative to the list of arguments being processed by the iteration.","type":"text"}],"type":"paragraph"},{"anchor":"Indirection-~","level":2,"text":"Indirection (~?)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~?","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" must be a string, and the one after it ","type":"text"},{"inlineContent":[{"text":"lst","type":"text"}],"type":"emphasis"},{"text":" must be a sequence (e.g. an array). Both arguments are consumed by the directive. ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is processed as a format control string, with the elements of the list ","type":"text"},{"inlineContent":[{"text":"lst","type":"text"}],"type":"emphasis"},{"text":" as the arguments. Once the recursive processing of the control string has been finished, then processing of the control string containing the ","type":"text"},{"code":"~?","type":"codeVoice"},{"text":" directive is resumed.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~? ~D\", args: \"(~A ~D)\", [\"Foo\", 5], 7)","⇒ (Foo 5) 7","try clformat(\"~? ~D\", args: \"(~A ~D)\", [\"Foo\", 5, 14], 7)","⇒ (Foo 5) 7"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Note that in the second example, three arguments are supplied to the control string ","type":"text"},{"code":"\"(~A ~D)\"","type":"codeVoice"},{"text":", but only two are processed and the third is therefore ignored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier, only one argument is directly consumed. The argument must be a string. It is processed as part of the control string as if it had appeared in place of the ","type":"text"},{"code":"~@?","type":"codeVoice"},{"text":" directive, and any directives in the recursively processed control string may consume arguments of the control string containing the ","type":"text"},{"code":"~@?","type":"codeVoice"},{"text":" directive.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~@? ~D\", args: \"(~A ~D)\", \"Foo\", 5, 7)","⇒ (Foo 5) 7","try clformat(\"~@? ~D\", args: \"(~A ~D)\", \"Foo\", 5, 14, 7)","⇒ (Foo 5) 14"],"syntax":"swift","type":"codeListing"},{"anchor":"Conversion-~~","level":2,"text":"Conversion (~(…~))","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~(","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~)","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The contained control string ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" is processed, and what it produces is subject to a conversion. Without the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier, a ","type":"text"},{"inlineContent":[{"text":"case conversion","type":"text"}],"type":"emphasis"},{"text":" is performed. ","type":"text"},{"code":"~(","type":"codeVoice"},{"text":" converts every uppercase character to the corresponding lowercase character, ","type":"text"},{"code":"~:(","type":"codeVoice"},{"text":" capitalizes all words, ","type":"text"},{"code":"~@(","type":"codeVoice"},{"text":" capitalizes just the first word and forces the rest to lowercase, and ","type":"text"},{"code":"~:@(","type":"codeVoice"},{"text":" converts every lowercase character to the corresponding uppercase character. In the following example, ","type":"text"},{"code":"~@(","type":"codeVoice"},{"text":" is used to cause the first word produced by ","type":"text"},{"code":"~R","type":"codeVoice"},{"text":" to be capitalized:","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~@(~R~) error~:P\", args: 0)","⇒ Zero errors","try clformat(\"~@(~R~) error~:P\", args: 1)","⇒ One error","try clformat(\"~@(~R~) error~:P\", args: 23)","⇒ Twenty-three errors"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier is provided together with the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier, all characters corresponding to named XML entities are being converted into named XML entities. If modifier ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" is added, then only those characters are converted which conflict with XML syntax. The modifier combination ","type":"text"},{"code":"+@","type":"codeVoice"},{"text":" converts the output by stripping off all diacritics. Modifier ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" only will escape characters such that the result can be used as a Swift string literal.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~+:(~A~)\", args: \"© 2021–2023 TÜV\")","⇒ &copy; 2021&ndash;2023 T&Uuml;V","try clformat(\"~+:@(~A~)\", args: \"<a href=\\\"t.html\\\">© TÜV</a>\")","⇒ &lt;a href=&quot;t.html&quot;&gt;© TÜV&lt;/a&gt;","try clformat(\"~+@(~A~)\", args: \"épistèmê\")","⇒ episteme","try clformat(\"~+(~A~)\", args: \"Hello \\\"World\\\"\\n\")","⇒ Hello \\\"World\\\"\\n"],"syntax":"swift","type":"codeListing"},{"anchor":"Conditional-~~","level":2,"text":"Conditional (~[…~])","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~[","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"str₀","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~;","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"str₁","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~;…~;","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"strₙ","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~]","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"This is a set of control strings, called clauses, one of which is chosen and used. The clauses are separated by ","type":"text"},{"code":"~;","type":"codeVoice"},{"text":" and the construct is terminated by ","type":"text"},{"code":"~]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Without default:","type":"text"}],"type":"emphasis"},{"text":"  From a conditional directive ","type":"text"},{"code":"~[","type":"codeVoice"},{"inlineContent":[{"text":"str₀","type":"text"}],"type":"emphasis"},{"code":"~;","type":"codeVoice"},{"inlineContent":[{"text":"str₁","type":"text"}],"type":"emphasis"},{"code":"~;…~;","type":"codeVoice"},{"inlineContent":[{"text":"strₙ","type":"text"}],"type":"emphasis"},{"code":"~]","type":"codeVoice"},{"text":", the ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":"-th clause is selected, where the first clause is number 0. If a prefix parameter is given as ","type":"text"},{"code":"~n[","type":"codeVoice"},{"text":", then the parameter ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is used instead of an argument. This is useful only if the parameter is specified by ","type":"text"},{"code":"#","type":"codeVoice"},{"text":", to dispatch on the number of arguments remaining to be processed. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is out of range, then no clause is selected and no error is signaled. After the selected alternative has been processed, the control string continues after the ","type":"text"},{"code":"~]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"With default:","type":"text"}],"type":"emphasis"},{"text":"  Whenever the directive has the form ","type":"text"},{"code":"~[","type":"codeVoice"},{"inlineContent":[{"text":"str₀","type":"text"}],"type":"emphasis"},{"code":"~;","type":"codeVoice"},{"inlineContent":[{"text":"str₁","type":"text"}],"type":"emphasis"},{"code":"~;…~:;","type":"codeVoice"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"code":"~]","type":"codeVoice"},{"text":", i.e. the last clause is separated via ","type":"text"},{"code":"~:;","type":"codeVoice"},{"text":", then the conditional directive has a default clause which gets performed whenever no other clause could be selected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Optional selector:","type":"text"}],"type":"emphasis"},{"text":"  Whenever the directive has the form ","type":"text"},{"code":"~:[","type":"codeVoice"},{"inlineContent":[{"text":"none","type":"text"}],"type":"emphasis"},{"code":"~;","type":"codeVoice"},{"inlineContent":[{"text":"some","type":"text"}],"type":"emphasis"},{"code":"~]","type":"codeVoice"},{"text":" the ","type":"text"},{"inlineContent":[{"text":"none","type":"text"}],"type":"emphasis"},{"text":" control string is chosen if ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", otherwise the ","type":"text"},{"inlineContent":[{"text":"some","type":"text"}],"type":"emphasis"},{"text":" control string is chosen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Boolean selector:","type":"text"}],"type":"emphasis"},{"text":"  Whenever the directive has the form ","type":"text"},{"code":"~+[","type":"codeVoice"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"code":"~;","type":"codeVoice"},{"inlineContent":[{"text":"true","type":"text"}],"type":"emphasis"},{"code":"~]","type":"codeVoice"},{"text":" the ","type":"text"},{"inlineContent":[{"text":"false","type":"text"}],"type":"emphasis"},{"text":" control string is chosen if ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is the boolean value ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", otherwise the ","type":"text"},{"inlineContent":[{"text":"true","type":"text"}],"type":"emphasis"},{"text":" control string is chosen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Selector test:","type":"text"}],"type":"emphasis"},{"text":"  Whenever the directive has the form ","type":"text"},{"code":"~@[","type":"codeVoice"},{"inlineContent":[{"text":"true","type":"text"}],"type":"emphasis"},{"code":"~]","type":"codeVoice"},{"text":", the next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is tested for being non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", then the argument is not used up by the ","type":"text"},{"code":"~@[","type":"codeVoice"},{"text":" directive but remains as the next one to be processed, and the one clause ","type":"text"},{"inlineContent":[{"text":"true","type":"text"}],"type":"emphasis"},{"text":" is processed. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", then the argument is used up, and the clause is not processed. The clause therefore should normally use exactly one argument, and may expect it to be non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Iteration-~~","level":2,"text":"Iteration (~{…~})","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"{","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"~}","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The iteration directive is used to control how a sequence is output. Thus, the next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" should be a sequence which is used as a list of arguments as if for a recursive call to ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":". The string ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" is used repeatedly as the control string until all elements from ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" are consumed. Each iteration can absorb as many elements of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" as it needs. For instance, if ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" uses up two arguments by itself, then two elements of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" will get used up each time around the loop. If before any iteration step the sequence is empty, then the iteration is terminated. Also, if a prefix parameter ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is given, then there will be at most ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" repetitions of processing of ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":". Finally, the ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" directive can be used to terminate the iteration prematurely. If the iteration is terminated before all the remaining arguments are consumed, then any arguments not processed by the iteration remain to be processed by any directives following the iteration construct.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Winners:~{ ~A~}.\", args: [\"Fred\", \"Harry\", \"Jill\"])","⇒ Winners: Fred Harry Jill.","try clformat(\"Winners: ~{~#[~;~A~:;~A, ~]~}.\", args: [\"Fred\", \"Harry\", \"Jill\"])","⇒ Winners: Fred, Harry, Jill.","try clformat(\"Pairs:~{ <~A,~S>~}.\", args: [\"A\", 1, \"B\", 2, \"C\", 3])","⇒ Pairs: <A,1> <B,2> <C,3>."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"~:n,m{str~}","type":"codeVoice"},{"text":" is similar, but the argument should be a list of sublists. At each repetition step (capped by ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), one sublist is used as the list of arguments for processing ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" with an iteration cap of ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":". On the next repetition, a new sublist is used, whether or not all elements of the last sublist had been processed.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Pairs:~:{ <~A,~S>~}.\", args: [[\"A\", 1], [\"B\", 2], [\"C\", 3]])","⇒ Pairs: <A,1> <B,2> <C,3>."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"~@{str~}","type":"codeVoice"},{"text":" is similar to ","type":"text"},{"code":"~{str~}","type":"codeVoice"},{"text":", but instead of using one argument that is a sequence, all the remaining arguments are used as the list of arguments for the iteration.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Pairs:~@{ <~A,~S>~}.\", args: \"A\", 1, \"B\", 2, \"C\", 3)","⇒ Pairs: <A,1> <B,2> <C,3>."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"~:@{str~}","type":"codeVoice"},{"text":" combines the features of ","type":"text"},{"code":"~:{str~}","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"~@{str~}","type":"codeVoice"},{"text":". All the remaining arguments are used, and each one must be a sequence. On each iteration, the next argument is used as a list of arguments to ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Pairs:~:@{ <~A,~S>~}.\", args: [\"A\", 1], [\"B\", 2], [\"C\", 3])","⇒ Pairs: <A,1> <B,2> <C,3>."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Terminating the repetition directive with ","type":"text"},{"code":"~:}","type":"codeVoice"},{"text":" instead of ","type":"text"},{"code":"~}","type":"codeVoice"},{"text":" forces ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" to be processed at least once, even if the initial sequence is empty. However, it will not override an explicit prefix parameter of zero. If ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":" is empty, then an argument is used as ","type":"text"},{"inlineContent":[{"text":"str","type":"text"}],"type":"emphasis"},{"text":". It must be a string and precede any arguments processed by the iteration.","type":"text"}],"type":"paragraph"},{"anchor":"Up-and-out-~%5E","level":2,"text":"Up and out (~^)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~^","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Continue:","type":"text"}],"type":"emphasis"},{"text":"  The ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" directive is an escape construct. If there are no more arguments remaining to be processed, then the immediately enclosing ","type":"text"},{"code":"~{","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"~<","type":"codeVoice"},{"text":" directive is terminated. If there is no such enclosing directive, then the entire formatting operation is terminated. In the case of ","type":"text"},{"code":"~<","type":"codeVoice"},{"text":", the formatting is performed, but no more segments are processed before doing the justification. The ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" directive should appear only at the beginning of a ","type":"text"},{"code":"~<","type":"codeVoice"},{"text":" clause, because it aborts the entire clause it appears in, as well as all following clauses. ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" may appear anywhere in a ","type":"text"},{"code":"~{","type":"codeVoice"},{"text":" construct.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"Done.~^ ~D warning~:P.~^ ~D error~:P.\")","⇒ Done.","try clformat(\"Done.~^ ~D warning~:P.~^ ~D error~:P.\", args: 3)","⇒ Done. 3 warnings.","try clformat(\"Done.~^ ~D warning~:P.~^ ~D error~:P.\", args: 1, 5)","⇒ Done. 1 warning. 5 errors."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the directive has the form ","type":"text"},{"code":"~n^","type":"codeVoice"},{"text":", then termination occurs if ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is zero. If the directive has the form ","type":"text"},{"code":"~n,m^","type":"codeVoice"},{"text":", termination occurs if the value of ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" equals the value of ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":". If the directive has the form ","type":"text"},{"code":"~n,m,o^","type":"codeVoice"},{"text":", termination occurs if ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"text":"o","type":"text"}],"type":"emphasis"},{"text":". Of course, this is useless if all the prefix parameters are literals. At least one of them should be a ","type":"text"},{"code":"#","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Break:","type":"text"}],"type":"emphasis"},{"text":"  If ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" is used within a ","type":"text"},{"code":"~:{","type":"codeVoice"},{"text":" directive, then it merely terminates the current iteration step because in the standard case, it tests for remaining arguments of the current step only and the next iteration step commences immediately. To terminate the entire iteration process, use ","type":"text"},{"code":"~:^","type":"codeVoice"},{"text":". ","type":"text"},{"code":"~:^","type":"codeVoice"},{"text":" may only be used if the directive it would terminate is ","type":"text"},{"code":"~:{","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"~:@{","type":"codeVoice"},{"text":". The entire iteration process is terminated if and only if the sublist that is supplying the arguments for the current iteration step is the last sublist (in the case of terminating a ","type":"text"},{"code":"~:{","type":"codeVoice"},{"text":" directive) or the last argument to that call to format (in the case of terminating a ","type":"text"},{"code":"~:@{","type":"codeVoice"},{"text":" directive).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that while ","type":"text"},{"code":"~^","type":"codeVoice"},{"text":" is equivalent to ","type":"text"},{"code":"~#^","type":"codeVoice"},{"text":" in all circumstances, ","type":"text"},{"code":"~:^","type":"codeVoice"},{"text":" is not equivalent to ","type":"text"},{"code":"~#:^","type":"codeVoice"},{"text":" because the latter terminates the entire iteration if and only if no arguments remain for the current iteration step, as opposed to no arguments remaining for the entire iteration process.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~:{/~A~^ ...~}\",","             args: [[\"hot\", \"dog\"], [\"hamburger\"], [\"ice\", \"cream\"], [\"french\", \"fries\"]])","⇒ /hot .../hamburger/ice .../french ...","try clformat(\"~:{/~A~:^ ...~}\",","             args: [[\"hot\", \"dog\"], [\"hamburger\"], [\"ice\", \"cream\"], [\"french\", \"fries\"]])","⇒ /hot .../hamburger .../ice .../french","try clformat(\"~:{/~A~#:^ ...~}\",","             args: [[\"hot\", \"dog\"], [\"hamburger\"], [\"ice\", \"cream\"], [\"french\", \"fries\"]])","⇒ /hot .../hamburger"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/Directives":{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/Directives","kind":"article","role":"collectionGroup","title":"Directive reference","type":"topic","url":"/documentation/clformat/directives"},"doc://CLFormat/documentation/CLFormat/FloatDirectives":{"abstract":[{"text":"Output floating-point numbers in fixed, exponential, and monetary formats.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/FloatDirectives","kind":"article","role":"article","title":"Floating-point directives","type":"topic","url":"/documentation/clformat/floatdirectives"},"doc://CLFormat/documentation/CLFormat/IntegerDirectives":{"abstract":[{"text":"Output integers in decimal and other radixes, as roman numerals, or in natural language.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","kind":"article","role":"article","title":"Integer directives","type":"topic","url":"/documentation/clformat/integerdirectives"},"doc://CLFormat/documentation/CLFormat/LayoutDirectives":{"abstract":[{"text":"Control newlines, tabulation, and the justification of text.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","kind":"article","role":"article","title":"Layout directives","type":"topic","url":"/documentation/clformat/layoutdirectives"},"doc://CLFormat/documentation/CLFormat/TextDirectives":{"abstract":[{"text":"Output arguments as text, characters, or plurals.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","kind":"article","role":"article","title":"Text and character directives","type":"topic","url":"/documentation/clformat/textdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Directives-by-category","generated":true,"identifiers":["doc://CLFormat/documentation/CLFormat/TextDirectives","doc://CLFormat/documentation/CLFormat/IntegerDirectives","doc://CLFormat/documentation/CLFormat/FloatDirectives","doc://CLFormat/documentation/CLFormat/LayoutDirectives"],"title":"Directives by category"}],"variants":[{"paths":["/documentation/clformat/controldirectives"],"traits":[{"interfaceLanguage":"swift"}]}]}