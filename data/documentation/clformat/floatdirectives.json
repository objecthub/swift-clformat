{"abstract":[{"text":"Output floating-point numbers in fixed, exponential, and monetary formats.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/Directives"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/FloatDirectives"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Floating-point directives"},"primaryContentSections":[{"content":[{"anchor":"Fixed-float-~F","level":2,"text":"Fixed float (~F)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"w,d,k,overchar,padchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"F","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as a floating-point number in a fixed format (ideally without exponent) of exactly ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" characters, if ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" is specified. First, leading ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" characters (default: ’ ’) are output, if necessary, to pad the field on the left. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is negative, then a minus sign is printed. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not negative, then a plus sign is printed if and only if the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier was specified. Then a sequence of digits, containing a single embedded decimal point, is printed. If parameter ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is provided, then exactly ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" decimal places are output. This represents the magnitude of the value of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" times 10ᵏ, rounded to ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" fractional digits. There are no leading zeros, except that a single zero digit is output before the decimal point if the printed value is less than 1.0, and this single zero digit is not output after all if ","type":"text"},{"inlineContent":[{"text":"w = d","type":"text"}],"type":"emphasis"},{"text":" + 1.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If it is impossible to print the value in the required format in a field of width ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":", then one of two actions is taken: If the parameter ","type":"text"},{"inlineContent":[{"text":"overchar","type":"text"}],"type":"emphasis"},{"text":" is specified, then ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" copies of this character are printed. If ","type":"text"},{"inlineContent":[{"text":"overchar","type":"text"}],"type":"emphasis"},{"text":" is omitted, then the scaled value of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is printed using more than ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" characters.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the width parameter ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" is omitted, then the output is of variable width and a value is chosen for ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" in such a way that no leading padding characters are needed and exactly ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" characters will follow the decimal point. For example, the directive ","type":"text"},{"code":"~,2F","type":"codeVoice"},{"text":" will output exactly two digits after the decimal point and as many as necessary before the decimal point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is omitted, then there is no constraint on the number of digits to appear after the decimal point. A value is chosen for ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" in such a way that as many digits as possible may be printed subject to the width constraint imposed by ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" and the constraint that no trailing zero digits may appear in the fraction, except that if the fraction is zero, then a single zero digit should appear after the decimal point if permitted by the width constraint.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" is omitted, then if the magnitude of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is so large (or, if ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is also omitted, so small) that more than 100 digits would have to be printed, then ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output using exponential notation instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"~F","type":"codeVoice"},{"text":" directive also supports grouping of the integer part of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":"; this can be enabled via the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier. ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘,’) specifies which character should be used to separate sequences of ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":" (default: 3) digits in the integer part of the output. If locale-specific settings should be used, the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier needs to be set.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~F\", args: 123.1415926)","⇒ 123.1415926","try clformat(\"~8F\", args: 123.1415926)","⇒ 123.1416","try clformat(\"~8,,,'-F\", args: 123.1415926)","⇒ 123.1416","try clformat(\"~8,,,'-F\", args: 123456789.12)","⇒ --------","try clformat(\"~8,,,,'0F\", args: 123.14)","⇒ 00123.14","try clformat(\"~8,3,,,'0F\", args: 123.1415926)","⇒ 0123.142","try clformat(\"~,4F\", args: 123.1415926)","⇒ 123.1416","try clformat(\"~,2@F\", args: 123.1415926)","⇒ +123.14","try clformat(\"~,2,-2@F\", args: 314.15926)","⇒ +3.14","try clformat(\"~,2:F\", args: 1234567.891)","⇒ 1,234,567.89","try clformat(\"~,2,,,,'',3:F\", args: 1234567.891)","⇒ 1'234'567.89"],"syntax":"swift","type":"codeListing"},{"anchor":"Exponential-float-~E","level":2,"text":"Exponential float (~E)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"w,d,e,k,overchar,padchar,expchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"E","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as a floating-point number in an exponential format of exactly ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" characters, if ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" is specified. Parameter ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is the number of digits to print after the decimal point, ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" is the number of digits to use when printing the exponent, and ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" is a scale factor that defaults to 1.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"First, leading ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) characters are output, if necessary, to pad the output on the left. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is negative, then a minus sign is printed. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not negative, then a plus sign is printed if and only if the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier was specified. Then a sequence of digits, containing a single embedded decimal point, is output. The form of this sequence of digits depends on the scale factor ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" is zero, then ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" digits are printed after the decimal point, and a single zero digit appears before the decimal point. If ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" is positive, then it must be strictly less than ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" + 2 and ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" significant digits are printed before the decimal point, and ","type":"text"},{"inlineContent":[{"text":"d − k","type":"text"}],"type":"emphasis"},{"text":" + 1 digits are printed after the decimal point. If ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" is negative, then it must be strictly greater than ","type":"text"},{"inlineContent":[{"text":"−d","type":"text"}],"type":"emphasis"},{"text":". A single zero digit appears before the decimal point and after the decimal point, first ","type":"text"},{"inlineContent":[{"text":"−k","type":"text"}],"type":"emphasis"},{"text":" zeros are output followed by ","type":"text"},{"inlineContent":[{"text":"d + k","type":"text"}],"type":"emphasis"},{"text":" significant digits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Following the digit sequence, the exponent is output following character ","type":"text"},{"inlineContent":[{"text":"expchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘E’) and the sign of the exponent, i.e. either the plus or the minus sign. The exponent consists of ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" digits representing the power of 10 by which the fraction must be multiplied to properly represent the rounded value of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If it is impossible to print the value in the required format in a field of width ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":", then one of two actions is taken: If the parameter ","type":"text"},{"inlineContent":[{"text":"overchar","type":"text"}],"type":"emphasis"},{"text":" is specified, then ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" copies of this character are printed instead of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"overchar","type":"text"}],"type":"emphasis"},{"text":" is omitted, then ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is printed using more than ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" characters, as many more as may be needed. If ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is too small for the specified ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" is too small, then a larger value is used for ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" as may be needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" parameter is omitted, then the output is of variable width and a value is chosen for ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" in such a way that no leading padding characters are needed.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~E\", args: 31.415926)","⇒ 3.1415926E+1","try clformat(\"~,5E\", args: 0.0003141592)","⇒ 3.14159E-4","try clformat(\"~,4,2E\", args: 0.0003141592)","⇒ 3.1416E-04","try clformat(\"~9E\", args: 31.415926)","⇒ 3.1416E+1","try clformat(\"~10,3,,,,'#E\", args: 31.415926)","⇒ ##3.142E+1","try clformat(\"~10,4,,3,,'#E\", args: 31.415926)","⇒ #314.16E-1","try clformat(\"~7,3,2,,'-E\", args: 31.415926)","⇒ -------","try clformat(\"~10,4,,4,,'#@E\", args: 31.415926)","⇒ +3141.6E-2"],"syntax":"swift","type":"codeListing"},{"anchor":"General-float-~G","level":2,"text":"General float (~G)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"w,d,e,k,overchar,padchar,expchar","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"G","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as a floating-point number in either fixed-format or exponential notation as appropriate. The format in which to print ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" depends on the magnitude (absolute value) of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":". Let ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" be an integer such that 10ⁿ⁻¹ ≤ ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" < 10ⁿ. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is zero, let ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" be 0. Let ","type":"text"},{"inlineContent":[{"text":"ee","type":"text"}],"type":"emphasis"},{"text":" equal ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" + 2, or 4 if ","type":"text"},{"inlineContent":[{"text":"e","type":"text"}],"type":"emphasis"},{"text":" is omitted. Let ","type":"text"},{"inlineContent":[{"text":"ww","type":"text"}],"type":"emphasis"},{"text":" equal ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" − ","type":"text"},{"inlineContent":[{"text":"ee","type":"text"}],"type":"emphasis"},{"text":", or nil if ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" is omitted. If ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" is omitted, first let ","type":"text"},{"inlineContent":[{"text":"q","type":"text"}],"type":"emphasis"},{"text":" be the number of digits needed to print ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" with no loss of information and without leading or trailing zeros; then let ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" equal ","type":"text"},{"inlineContent":[{"text":"max(q, min(n, 7))","type":"text"}],"type":"emphasis"},{"text":". Let ","type":"text"},{"inlineContent":[{"text":"dd","type":"text"}],"type":"emphasis"},{"text":" equal ","type":"text"},{"inlineContent":[{"text":"d − n","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If 0 ≤ ","type":"text"},{"inlineContent":[{"text":"dd","type":"text"}],"type":"emphasis"},{"text":" ≤ ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":", then ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as if by the format directives:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"~ww,dd,,overchar,padcharF~ee@T","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that the scale factor ","type":"text"},{"inlineContent":[{"text":"k","type":"text"}],"type":"emphasis"},{"text":" is not passed to the ","type":"text"},{"code":"~F","type":"codeVoice"},{"text":" directive. For all other values of ","type":"text"},{"inlineContent":[{"text":"dd","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is printed as if by the format directive:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"~w,d,e,k,overchar,padchar,expcharE","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"text":"In either case, an ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier is specified to the ","type":"text"},{"code":"~F","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"~E","type":"codeVoice"},{"text":" directive if and only if one was specified to the ","type":"text"},{"code":"~G","type":"codeVoice"},{"text":" directive.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"|~G|\", args: 712.72)","⇒ |712.72    |","try clformat(\"|~12G|\", args: 712.72)","⇒ |  712.72    |","try clformat(\"|~9,2G|~9,3,2,3G|~9,3,2,0G|\", args: 0.031415, 0.031415, 0.031415)","⇒ |  3.14E-2|314.2E-04|0.314E-01|","try clformat(\"|~9,2G|~9,3,2,3G|~9,3,2,0G|\", args: 0.314159, 0.314159, 0.314159)","⇒ | 0.31    |0.314    |0.314    |","try clformat(\"|~9,2G|~9,3,2,3G|~9,3,2,0G|\", args: 3.14159, 3.14159, 3.14159)","⇒ |  3.1    | 3.14    | 3.14    |","try clformat(\"|~9,2G|~9,3,2,3G|~9,3,2,0G|\", args: 314.159, 314.159, 314.159)","⇒ |  3.14E+2|  314    |  314    |","try clformat(\"|~9,2G|~9,3,2,3G|~9,3,2,0G|\", args: 3141.59, 3141.59, 3141.59)","⇒ |  3.14E+3|314.2E+01|0.314E+04|"],"syntax":"swift","type":"codeListing"},{"anchor":"Dollars-float-~$","level":2,"text":"Dollars float (~$)","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Syntax:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"~","type":"text"}],"type":"strong"},{"inlineContent":[{"text":"d,n,w,padchar,curchar,groupchar,groupcol","type":"text"}],"type":"emphasis"},{"inlineContent":[{"text":"$","type":"text"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"The next argument ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is output as a floating-point number in a fixed-format notation that is particularly well suited for outputting monetary values. Parameter ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" (default: 2) defines the number of digits to print after the decimal point. Parameter ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" (default: 1) defines the minimum number of digits to print before the decimal point. Parameter ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" (default: 0) is the minimum total width of the output.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"First, padding and the sign are output. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is negative, then a minus sign is printed. If ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is not negative, then a plus sign is printed if and only if the ","type":"text"},{"code":"@","type":"codeVoice"},{"text":" modifier was specified. If the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier is used, the sign appears before any padding, and otherwise after the padding. If the number of characters, including the sign and a potential currency symbol is below width ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":", then character ","type":"text"},{"inlineContent":[{"text":"padchar","type":"text"}],"type":"emphasis"},{"text":" (default: ’ ’) is used for padding the number in front of the integer part such that the overall output has ","type":"text"},{"inlineContent":[{"text":"w","type":"text"}],"type":"emphasis"},{"text":" characters. After the padding, the currency symbol ","type":"text"},{"inlineContent":[{"text":"curchar","type":"text"}],"type":"emphasis"},{"text":" is inserted, if available, followed by ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" digits representing the integer part of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":", prefixed by the right amount of ‘0’ characters. If either parameter ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":" is provided, the integer part is output in groups of ","type":"text"},{"inlineContent":[{"text":"groupcol","type":"text"}],"type":"emphasis"},{"text":" characters (default: 3) separated by ","type":"text"},{"inlineContent":[{"text":"groupchar","type":"text"}],"type":"emphasis"},{"text":" (default: ‘,’). After the integer part, a decimal point is output followed by ","type":"text"},{"inlineContent":[{"text":"d","type":"text"}],"type":"emphasis"},{"text":" digits of fraction, properly rounded.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the magnitude of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" is so large that the integer part of ","type":"text"},{"inlineContent":[{"text":"arg","type":"text"}],"type":"emphasis"},{"text":" cannot be output with at most ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" characters, then more characters are generated, as needed, and the total width might overrun as well.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For cases where a simple currency symbol is not sufficient, it is possible to use a numeric currency code as defined by ISO 4217 for parameter ","type":"text"},{"inlineContent":[{"text":"curchar","type":"text"}],"type":"emphasis"},{"text":". For positive codes, the shortest currency symbol is being used. For negative currency codes, the corresponding alphabetic code (ignoring the sign) is being used. Struct ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/Currency","isActive":true,"type":"reference"},{"text":" provides a convenient way to access currency codes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"By specifying the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier, it is possible to enable locale-specific output of the monetary value using the locale provided to function ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":". In this case, also the currency associated with this locale is being used.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~$\", args: 4930.351)","⇒ 4930.35","try clformat(\"~3$\", args: 4930.351)","⇒ 4930.351","try clformat(\"~,6$\", args: 4930.351)","⇒ 004930.35","try clformat(\"~,6,12,'_$\", args: 4930.351)","⇒ ___004930.35","try clformat(\"~,6,12,'_@$\", args: 4930.351)","⇒ __+004930.35","try clformat(\"~,6,12,'_@:$\", args: 4930.351)","⇒ +__004930.35","try clformat(\"~,6,12,'_,'€$\", args: 4930.351)","⇒ __€004930.35","try clformat(\"~,6,12,'_,'€@$\", args: 4930.351)","⇒ _+€004930.35","try clformat(\"~,,,,,,3$\", args: 4930.351)","⇒ 4,930.35","try clformat(\"~,6,,,,,3$\", args: 4930.351)","⇒ 004,930.35","try clformat(\"~,,,,208$\", args: 1234.567)","⇒ kr 1234.57","try clformat(\"~,,,,-208$\", args: 1234.567)","⇒ DKK 1234.57","try clformat(\"~+$\", locale: Locale(identifier: \"de_CH\"), args: 4930.351)","⇒ CHF 4930.35","try clformat(\"~,,,,,,3+$\", locale: Locale(identifier: \"en_US\"), args: 4930.351)","⇒ $4,930.35","try clformat(\"~,6,14,'_,,,3+$\", locale: Locale(identifier: \"de_DE\"), args: 4930.351)","⇒ __004.930,35 €"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/ControlDirectives":{"abstract":[{"text":"Navigate arguments, process control strings recursively, convert case, and select or repeat parts of a control string.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/ControlDirectives","kind":"article","role":"article","title":"Control directives","type":"topic","url":"/documentation/clformat/controldirectives"},"doc://CLFormat/documentation/CLFormat/Currency":{"abstract":[{"text":"Representation of currencies supporting the use of the ","type":"text"},{"code":"~$","type":"codeVoice"},{"text":" directive.","type":"text"},{"text":" ","type":"text"},{"text":"CLFormat supports an extension of ","type":"text"},{"code":"~$","type":"codeVoice"},{"text":" which allows for including currency","type":"text"},{"text":" ","type":"text"},{"text":"codes and currency symbols in the output. The representation of currencies","type":"text"},{"text":" ","type":"text"},{"text":"is based on ISO 4217.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Currency"}],"identifier":"doc://CLFormat/documentation/CLFormat/Currency","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Currency"}],"role":"symbol","title":"Currency","type":"topic","url":"/documentation/clformat/currency"},"doc://CLFormat/documentation/CLFormat/Directives":{"abstract":[{"text":"All directives supported by the formatting language, with parameters, modifiers, and examples.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/Directives","kind":"article","role":"collectionGroup","title":"Directive reference","type":"topic","url":"/documentation/clformat/directives"},"doc://CLFormat/documentation/CLFormat/IntegerDirectives":{"abstract":[{"text":"Output integers in decimal and other radixes, as roman numerals, or in natural language.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/IntegerDirectives","kind":"article","role":"article","title":"Integer directives","type":"topic","url":"/documentation/clformat/integerdirectives"},"doc://CLFormat/documentation/CLFormat/LayoutDirectives":{"abstract":[{"text":"Control newlines, tabulation, and the justification of text.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/LayoutDirectives","kind":"article","role":"article","title":"Layout directives","type":"topic","url":"/documentation/clformat/layoutdirectives"},"doc://CLFormat/documentation/CLFormat/TextDirectives":{"abstract":[{"text":"Output arguments as text, characters, or plurals.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/TextDirectives","kind":"article","role":"article","title":"Text and character directives","type":"topic","url":"/documentation/clformat/textdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Directives-by-category","generated":true,"identifiers":["doc://CLFormat/documentation/CLFormat/TextDirectives","doc://CLFormat/documentation/CLFormat/IntegerDirectives","doc://CLFormat/documentation/CLFormat/LayoutDirectives","doc://CLFormat/documentation/CLFormat/ControlDirectives"],"title":"Directives by category"}],"variants":[{"paths":["/documentation/clformat/floatdirectives"],"traits":[{"interfaceLanguage":"swift"}]}]}