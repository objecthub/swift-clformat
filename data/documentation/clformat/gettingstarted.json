{"abstract":[{"text":"Format values with ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":", reuse control strings, and adapt the output to locales.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/GettingStarted"},"kind":"article","metadata":{"modules":[{"name":"CLFormat"}],"role":"article","roleHeading":"Article","title":"Getting started with CLFormat"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The primary function is ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/clformat(_:config:locale:tabsize:linewidth:displayWidth:args:)","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It takes a control string followed by the arguments to format and returns the formatted string:","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~A is ~D year~:P old.\", args: \"John\", 32)","// \"John is 32 years old.\"","try clformat(\"~A is ~D year~:P old.\", args: \"Vicky\", 1)","// \"Vicky is 1 year old.\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Directives start with a tilde (","type":"text"},{"code":"~","type":"codeVoice"},{"text":"), optionally followed by comma-separated ","type":"text"},{"inlineContent":[{"text":"parameters","type":"text"}],"type":"emphasis"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"the modifiers ","type":"text"},{"code":":","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"+","type":"codeVoice"},{"text":", and end with a character that identifies the directive (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/Directives","isActive":true,"type":"reference"},{"text":" for a reference of all directives). For","type":"text"},{"text":" ","type":"text"},{"text":"example, ","type":"text"},{"code":"~,2F","type":"codeVoice"},{"text":" prints a floating-point number with two fractional digits, and ","type":"text"},{"code":"~:D","type":"codeVoice"},{"text":" groups","type":"text"},{"text":" ","type":"text"},{"text":"the digits of an integer.","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"~,2F\", args: 3.14159)                 // \"3.14\"","try clformat(\"~:D\", args: 1234567)                  // \"1,234,567\"","try clformat(\"~@R\", args: 1994)                     // \"MCMXCIV\"","try clformat(\"~R\", args: 21)                        // \"twenty-one\"","try clformat(\"~{~A~^, ~}\", args: [\"a\", \"b\", \"c\"])   // \"a, b, c\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Parameters can also be taken from the arguments by using ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", or be set to the number of","type":"text"},{"text":" ","type":"text"},{"text":"remaining arguments with ","type":"text"},{"code":"#","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"|~vA|\", args: 6, \"text\")              // \"|text  |\""],"syntax":"swift","type":"codeListing"},{"anchor":"Strings-and-printing","level":3,"text":"Strings and printing","type":"heading"},{"inlineContent":[{"text":"There are equivalent ways to format values. The ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" initializers integrate with Swift’s","type":"text"},{"text":" ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" API, and ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/clprintf(_:config:locale:tabsize:linewidth:displayWidth:args:terminator:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"prints the result to the standard output:","type":"text"}],"type":"paragraph"},{"code":["let message = try String(control: \"~D item~:P\", args: 3)","try clprintf(\"Total: ~D item~:P\", args: 3)"],"syntax":"swift","type":"codeListing"},{"anchor":"Reusing-control-strings","level":3,"text":"Reusing control strings","type":"heading"},{"inlineContent":[{"text":"Every call of ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/clformat(_:config:locale:tabsize:linewidth:displayWidth:args:)","isActive":true,"type":"reference"},{"text":" parses the","type":"text"},{"text":" ","type":"text"},{"text":"control string. If a control string is used repeatedly, parse it once with ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/CLControl","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"format it as often as needed. A ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/CLControl","isActive":true,"type":"reference"},{"text":" value is immutable and can be used from several","type":"text"},{"text":" ","type":"text"},{"text":"threads at the same time:","type":"text"}],"type":"paragraph"},{"code":["let control = try CLControl(string: \"~A = ~,2F\")","for (name, value) in [(\"pi\", 3.14159), (\"e\", 2.71828)] {","  print(try control.format(args: name, value))","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Locales-and-display-width","level":3,"text":"Locales and display width","type":"heading"},{"inlineContent":[{"text":"Locale-specific output is enabled with the ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" modifier together with the ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":" parameter:","type":"text"}],"type":"paragraph"},{"code":["let german = Locale(identifier: \"de_DE\")","try clformat(\"~,2:+F\", locale: german, args: 1234.5)    // \"1.234,50\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"By default, padding and justification count characters. Setting ","type":"text"},{"code":"displayWidth","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" uses","type":"text"},{"text":" ","type":"text"},{"text":"the width a string occupies in a terminal instead, which aligns text containing emoji:","type":"text"}],"type":"paragraph"},{"code":["try clformat(\"|~4A|\", displayWidth: true, args: \"✅\")   // \"|✅  |\""],"syntax":"swift","type":"codeListing"},{"anchor":"Handling-errors","level":3,"text":"Handling errors","type":"heading"},{"inlineContent":[{"text":"Control strings are validated while they are parsed, and arguments are checked while they are","type":"text"},{"text":" ","type":"text"},{"text":"formatted. Both report problems by throwing errors instead of crashing:","type":"text"}],"type":"paragraph"},{"code":["do {","  _ = try clformat(\"~D\", args: \"text\")","} catch let error as CLFormatError {","  print(error)   // expected argument 0 to be a number; instead it is text","} catch let error as CLControlError {","  print(error)   // e.g. unknown directive ~Q","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Numeric parameters are limited to the range from ","type":"text"},{"code":"-Parameters.maxNumber","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"code":"Parameters.maxNumber","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Formatting-custom-types","level":3,"text":"Formatting custom types","type":"heading"},{"inlineContent":[{"text":"Types can control how they appear in the output of the ","type":"text"},{"code":"~A","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"~S","type":"codeVoice"},{"text":" directives by conforming","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/CLFormatConvertible","isActive":true,"type":"reference"},{"text":". Conforming to ","type":"text"},{"identifier":"doc://CLFormat/documentation/CLFormat/DebugCLFormatConvertible","isActive":true,"type":"reference"},{"text":" provides the","type":"text"},{"text":" ","type":"text"},{"text":"representation used by the ","type":"text"},{"code":":","type":"codeVoice"},{"text":" modifier (","type":"text"},{"code":"~:A","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/CLControl":{"abstract":[{"text":"Struct ","type":"text"},{"code":"Control","type":"codeVoice"},{"text":" represents a parsed control string. The driver of the","type":"text"},{"text":" ","type":"text"},{"text":"format function is provided by this struct. The format function can be","type":"text"},{"text":" ","type":"text"},{"text":"called arbitrary many times for a given struct (it is reentrant as well).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLControl"}],"identifier":"doc://CLFormat/documentation/CLFormat/CLControl","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CLControl"}],"role":"symbol","title":"CLControl","type":"topic","url":"/documentation/clformat/clcontrol"},"doc://CLFormat/documentation/CLFormat/CLFormatConvertible":{"abstract":[],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLFormatConvertible"}],"identifier":"doc://CLFormat/documentation/CLFormat/CLFormatConvertible","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CLFormatConvertible"}],"role":"symbol","title":"CLFormatConvertible","type":"topic","url":"/documentation/clformat/clformatconvertible"},"doc://CLFormat/documentation/CLFormat/DebugCLFormatConvertible":{"a