{"abstract":[{"text":"The default format configuration for the functions ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"clprintf","type":"codeVoice"},{"text":". This","type":"text"},{"text":" ","type":"text"},{"text":"configuation is mutable so that the behavior can be changed globally. Please note","type":"text"},{"text":" ","type":"text"},{"text":"that the ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" initializers do not rely on this mutable config as a default.","type":"text"}],"hierarchy":{"paths":[["doc://CLFormat/documentation/CLFormat","doc://CLFormat/documentation/CLFormat/CLFormatConfig"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://CLFormat/documentation/CLFormat/CLFormatConfig/default"},"kind":"symbol","metadata":{"externalID":"s:8CLFormat0A6ConfigV7defaultACvpZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"`default`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8CLFormat0A6ConfigV","text":"CLFormatConfig"}],"modules":[{"name":"CLFormat"}],"role":"symbol","roleHeading":"Type Property","symbolKind":"property","title":"default"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"`default`"},{"kind":"text","text":": "},{"identifier":"doc://CLFormat/documentation/CLFormat/CLFormatConfig","kind":"typeIdentifier","preciseIdentifier":"s:8CLFormat0A6ConfigV","text":"CLFormatConfig"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://CLFormat/documentation/CLFormat/CustomDirectives"]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Reading and writing the default configuration is thread-safe. Modifying individual","type":"text"},{"text":" ","type":"text"},{"text":"properties (e.g. ","type":"text"},{"code":"CLFormatConfig.default.nilRepresentation = \"null\"","type":"codeVoice"},{"text":") reads the","type":"text"},{"text":" ","type":"text"},{"text":"configuration, modifies a copy, and writes it back. This is not atomic: concurrent","type":"text"},{"text":" ","type":"text"},{"text":"modifications may overwrite each other. It is best to configure the default once at","type":"text"},{"text":" ","type":"text"},{"text":"startup, before formatting from multiple threads.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://CLFormat/documentation/CLFormat":{"abstract":[{"text":"Format text with the expressive control strings of Common Lisp’s ","type":"text"},{"code":"format","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat","kind":"symbol","role":"collection","title":"CLFormat","type":"topic","url":"/documentation/clformat"},"doc://CLFormat/documentation/CLFormat/CLFormatConfig":{"abstract":[{"text":"A format configuration value contains an argument factory, a default representation","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", as well as a mapping from directive identifiers (characters) to directive","type":"text"},{"text":" ","type":"text"},{"text":"parsers which parse the directive. Most directives are atomic (i.e. they are not","type":"text"},{"text":" ","type":"text"},{"text":"composite) and parsing for those is trivial: they just package up the generically","type":"text"},{"text":" ","type":"text"},{"text":"parsed parameters and modifiers in a new directive specifier value. Composite","type":"text"},{"text":" ","type":"text"},{"text":"directives have more complex parsing logic.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CLFormatConfig"}],"identifier":"doc://CLFormat/documentation/CLFormat/CLFormatConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CLFormatConfig"}],"role":"symbol","title":"CLFormatConfig","type":"topic","url":"/documentation/clformat/clformatconfig"},"doc://CLFormat/documentation/CLFormat/CLFormatConfig/default":{"abstract":[{"text":"The default format configuration for the functions ","type":"text"},{"code":"clformat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"clprintf","type":"codeVoice"},{"text":". This","type":"text"},{"text":" ","type":"text"},{"text":"configuation is mutable so that the behavior can be changed globally. Please note","type":"text"},{"text":" ","type":"text"},{"text":"that the ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" initializers do not rely on this mutable config as a default.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"`default`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8CLFormat0A6ConfigV","text":"CLFormatConfig"}],"identifier":"doc://CLFormat/documentation/CLFormat/CLFormatConfig/default","kind":"symbol","role":"symbol","title":"default","type":"topic","url":"/documentation/clformat/clformatconfig/default"},"doc://CLFormat/documentation/CLFormat/CustomDirectives":{"abstract":[{"text":"Extend the formatting language with your own directives, or remove standard ones.","type":"text"}],"identifier":"doc://CLFormat/documentation/CLFormat/CustomDirectives","kind":"article","role":"article","title":"Adding custom directives","type":"topic","url":"/documentation/clformat/customdirectives"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths